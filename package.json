    "sass": "^1.105.1",
    "standard-version": "^9.5.0",
    "start-server-and-test": "^3.0.13",
    "stylelint": "~17.16.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "~2.0.0",
    "stylelint-scss": "7.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13",
    "xml-js": "^1.6.11"
  },
  "overrides": {
    "proxy-agent": "^6.0.0",
    "browserify-sign": "^4.2.2",
    "@azure-rest/core-client": "2.3.5",
    "@azure/logger": "1.1.4",
    "@azure/core-util": "1.11.0",
    "@azure/core-client": "1.9.3",
    "@azure/core-rest-pipeline": "1.19.1",
    "@stablelib/ed25519": "^2.1.0",
    "protobufjs": "^7.6.6",
    "@metamask/utils": {
      "uuid": "^11.1.1"
    },
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@capacitor/assets": {
      "sharp": "^0.35.5",
      "@capacitor/cli": "$@capacitor/cli"
    },
    "@solana/web3.js": {
      "jayson": "^5.0.0"
    },
    "eslint-plugin-vue": {
      "postcss-selector-parser": "^7.1.6"
    },
    "vite-plugin-static-copy": {
      "chokidar": "^5.0.0"
    },
    "@vue/eslint-config-typescript": {
      "@typescript-eslint/eslint-plugin": "^8.71.2",
      "@typescript-eslint/parser": "$@typescript-eslint/parser"
    }
  },
  "standard-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "chore",
        "section": "Maintenance"
      },
      {
        "type": "docs",
        "section": "Documentation"
      },
      {
        "type": "style",
        "section": "Style"
      },
      {
        "type": "refactor",
        "section": "Maintenance"
      },
      {
        "type": "build",
        "section": "Maintenance"
      },
      {
        "type": "ci",
        "section": "Maintenance"
      },
      {
        "type": "perf",
        "section": "Performance"
      },
      {
        "type": "test",
        "section": "Tests"
      }
    ]
  }
