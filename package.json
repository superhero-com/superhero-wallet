{
  "name": "superhero-wallet",
  "version": "2.12.0",
  "description": "Superhero wallet",
  "author": "Superhero",
  "license": "ISC",
  "private": true,
  "scripts": {
    "lint:vue": "eslint . --ext .js,.ts,.vue",
    "lint:vue:fix": "eslint . --ext .js,.ts,.vue --fix",
    "lint:css": "stylelint src/**/*.{css,scss,vue}",
    "lint:commit": "commitlint --from develop --verbose",
    "lint": "cross-env NODE_ENV=production npm run lint:commit && npm run lint:vue && npm run lint:css",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:baseline": "node scripts/check-typecheck.mjs",
    "dev": "cross-env PLATFORM=web vite",
    "build": "cross-env PLATFORM=web vite build",
    "build:android": "cross-env PLATFORM=ionic vite build && npx cap sync android && npx cap open android",
    "build:ios": "cross-env PLATFORM=ionic vite build && npx cap sync ios && npx cap open ios",
    "build:ionic": "cross-env PLATFORM=ionic vite build",
    "build:extension": "npm run build:extension:chrome && npm run build:extension:ff",
    "build:extension:ff": "node scripts/build-extension.mjs firefox",
    "build:extension:chrome": "node scripts/build-extension.mjs chrome",
    "build:review:ff": "cross-env IS_FIREFOX_EXT=true REVIEW_BUILD=true node scripts/build-review.js",
    "build:web": "npm run build",
    "build-zip": "node scripts/build-zip.js",
    "serve": "npm run dev",
    "watch": "node scripts/build-extension.mjs chrome --watch",
    "watch:ff": "node scripts/build-extension.mjs firefox --watch",
    "test:unit": "vitest run",
    "test:vault:browser": "node scripts/check-wallet-vault-browser.mjs",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "cy:run": "cypress run",
    "test:e2e": "cross-env PLATFORM=web RUNNING_IN_TESTS=true NODE_ENV=development start-server-and-test serve http://localhost:8080 cy:run",
    "test:e2e:extension": "node scripts/build-extension.mjs chrome && vitest run --config vitest.e2e-extension.config.ts",
    "test:e2e:webkit": "vitest run --config vitest.e2e-webkit.config.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "build:Testnet": "cross-env NETWORK=Testnet npm run build:extension",
    "gen:capacitor-assets": "npx @capacitor/assets generate --iconBackgroundColor '#141414' --splashBackgroundColor '#141414' --splashBackgroundColorDark '#141414' --android --ios ",
    "cap-config": "trapeze run config.yaml",
    "release": "standard-version",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@aeternity/aepp-calldata": "^1.10.0",
