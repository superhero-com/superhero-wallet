{
  "name": "superhero-wallet",
  "version": "2.11.3",
  "description": "Superhero wallet",
  "author": "Superhero",
  "license": "ISC",
  "private": true,
  "scripts": {
    "lint:vue": "eslint . --ext .js,.ts,.vue",
    "lint:vue:fix": "eslint . --ext .js,.ts,.vue --fix",
    "lint:css": "stylelint src/**/*.{css,scss,vue}",
    "lint:commit": "commitlint --from develop --verbose",
    "lint": "cross-env NODE_ENV=production npm run lint:commit && npm run lint:vue && npm run lint:css",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "dev": "cross-env PLATFORM=web vite",
    "build": "cross-env PLATFORM=web vite build",
    "build:android": "cross-env PLATFORM=ionic vite build && npx cap sync android && npx cap open android",
    "build:ios": "cross-env PLATFORM=ionic vite build && npx cap sync ios && npx cap open ios",
    "build:ionic": "cross-env PLATFORM=ionic vite build",
    "build:extension": "npm run build:extension:chrome && npm run build:extension:ff",
    "build:extension:ff": "node scripts/build-extension.mjs firefox",
    "build:extension:chrome": "node scripts/build-extension.mjs chrome",
    "build:review:ff": "cross-env IS_FIREFOX_EXT=true REVIEW_BUILD=true node scripts/build-review.js",
    "build:web": "npm run build",
    "build-zip": "node scripts/build-zip.js",
    "serve": "npm run dev",
    "watch": "node scripts/build-extension.mjs chrome --watch",
    "watch:ff": "node scripts/build-extension.mjs firefox --watch",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "cy:run": "cypress run",
    "test:e2e": "cross-env PLATFORM=web RUNNING_IN_TESTS=true NODE_ENV=development start-server-and-test serve http://localhost:8080 cy:run",
    "test": "npm run test:unit && npm run test:e2e",
    "build:Testnet": "cross-env NETWORK=Testnet npm run build:extension",
    "gen:capacitor-assets": "npx @capacitor/assets generate --iconBackgroundColor '#141414' --splashBackgroundColor '#141414' --splashBackgroundColorDark '#141414' --android --ios ",
    "cap-config": "trapeze run config.yaml",
    "release": "standard-version",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@aeternity/aepp-calldata": "^1.9.1",
    "@aeternity/aepp-sdk": "15.0.1",
    "@aeternity/json-bigint": "^0.3.1",
    "@airgap/aeternity": "^0.13.46",
    "@airgap/serializer": "^0.13.46",
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@intlify/eslint-plugin-vue-i18n": "^2.0.0",
    "@ionic/vue": "^8.8.19",
    "@ionic/vue-router": "^8.8.19",
    "@ledgerhq/hw-transport-webusb": "^6.34.2",
    "@ngraveio/bc-ur": "^1.1.13",
    "@reown/walletkit": "^1.6.0",
    "@scure/bip39": "^2.4.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.99.0",
    "@vee-validate/rules": "^4.15.1",
    "@walletconnect/core": "2.25.0",
    "@walletconnect/utils": "2.25.0",
    "airgap-coin-lib": "^0.9.14",
    "bignumber.js": "^11.1.2",
    "bip32": "^5.0.1",
    "bitcoinjs-lib": "^7.0.4",
    "bs58check": "^4.0.0",
    "camelcase-keys-deep": "^0.1.0",
    "capacitor-native-settings": "^8.2.0",
    "dayjs": "^1.11.23",
    "detect-browser": "^5.3.0",
    "ecpair": "^3.0.2",
    "ed25519-hd-key": "^2.0.0",
    "jdenticon": "^3.3.0",
    "lodash-es": "^4.18.1",
    "qr-code-styling": "^1.9.2",
    "qr-scanner": "^1.4.2",
    "satoshi-bitcoin": "^1.0.7",
    "swagger-client": "3.38.2",
    "swiper": "^12.2.0",
    "uuid": "^14.0.3",
    "validator": "^13.15.35",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^4.6.4",
    "web3-eth": "^4.11.1",
    "web3-eth-accounts": "^4.3.1",
    "web3-eth-contract": "^4.7.2",
    "web3-types": "^1.10.0",
    "web3-utils": "^4.3.3",
    "web3-validator": "^2.0.6",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@rollup/plugin-inject": "^5.0.5",
    "@stylistic/eslint-plugin": "^3.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/webextension-polyfill": "^0.12.6",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-airbnb": "^8.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.5.1",
    "archiver": "^8.0.0",
    "core-js": "^3.50.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.1",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-cypress": "^2.15.2",
    "eslint-plugin-vue": "^9.33.0",
    "fs-extra": "^11.4.1",
