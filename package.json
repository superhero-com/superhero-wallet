    "qr-scanner": "^1.4.2",
    "satoshi-bitcoin": "^1.0.7",
    "swiper": "^14.4.0",
    "uuid": "^14.0.3",
    "validator": "^13.15.35",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.5.0",
    "web3-eth": "^4.11.1",
    "web3-eth-abi": "^4.4.1",
    "web3-eth-accounts": "^4.3.1",
    "web3-eth-contract": "^4.7.2",
    "web3-types": "^1.10.0",
    "web3-utils": "^4.3.3",
    "web3-validator": "^2.0.6",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@stylistic/eslint-plugin": "^3.1.0",
