{
  "name": "Superhero Wallet",
  "description": "Superhero Wallet is a multi-blockchain wallet to manage crypto assets and navigate the web3 and DeFi space.",
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src * data:; font-src 'self' data:; frame-src *; img-src * data:; style-src-elem 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; "
  },
  "permissions": [
    "storage",
    "scripting",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://wallet.superhero.com/*",
    "file://*/*",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "action": {
    "default_title": "Superhero Wallet",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon_16.png",
      "24": "icons/icon_24.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "all_frames": true,
      "matches": ["https://*/*", "http://*/*"],
      "js": ["js/inject.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "/index.html" ],
      "matches": [ "<all_urls>" ]
    },
    {
      "resources": [
        "CameraRequestPermission.html",
        "index.html"
      ],
      "matches": ["https://wallet.superhero.com/*"]
    }
  ],
  "side_panel": {
    "default_title": "Superhero Wallet",
    "default_path": "index.html?sidepanel"
  },
  "externally_connectable": {
    "matches": ["https://wallet.superhero.com/*"]
  },
  "sidebar_action": {
    "default_title": "Superhero Wallet",
    "default_panel": "index.html?sidepanel",
    "default_icon": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "128": "icons/icon_128.png"
    }
  }
}
